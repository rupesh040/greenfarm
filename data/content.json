      "Faq": {
        "variants": {
          "AgricultureFaq1": {
            "sectionId": "faq",
            "title": "Frequently Asked Questions",
            "highlightText": "Questions",
            "description": "Everything you need to know about our organic farming techniques, fresh harvest delivery timelines, and certified sustainable practices.",
            "image": "https://images.unsplash.com/photo-1595974482597-4b8da8879bc5?auto=format&fit=crop&w=800&q=80",
            "imageAlt": "Organic Farmer at GreenFarm",
            "helpTitle": "Need Any More Help & Advice?",
            "helpHighlight": "Help & Advice?",
            "helpDescription": "Speak directly with our agriculture specialists and certified agronomists to get answers tailored to your crop, supply, or organic nutrition needs.",
            "contactButton": {
              "label": "Contact Us",
              "href": "/contact"
            },
            "defaultOpenId": "faq-1",
            "faqs": [
              {
                "id": "faq-1",
                "question": "Are all your crops 100% certified organic and non-GMO?",
                "answer": "Yes, every single crop at GreenFarm is certified USDA Organic and non-GMO verified. We adhere strictly to biological and regenerative cultivation practices without synthetic fertilizers or chemical pesticides."
              },
              {
                "id": "faq-2",
                "question": "How quickly are farm products delivered after harvest?",
                "answer": "We harvest at sunrise and dispatch orders immediately. For local deliveries, produce arrives the very same day; for regional shipments, items are dispatched in climate-controlled eco-packaging within 24 hours."
              },
              {
                "id": "faq-3",
                "question": "What pest control methods do you use without synthetic chemicals?",
                "answer": "We rely on natural biological pest control, including companion planting, beneficial predatory insect habitats (such as ladybugs and lacewings), organic neem-based botanical sprays, and crop rotation."
              },
              {
                "id": "faq-4",
                "question": "Can I place wholesale or bulk orders for markets and restaurants?",
                "answer": "Absolutely! We supply fresh wholesale crates to local markets, farm-to-table restaurants, and community grocery co-ops. Reach out through our contact page to set up a regular delivery schedule."
              },
              {
                "id": "faq-5",
                "question": "Do you offer farm visits or educational field tours?",
                "answer": "Yes, we host guided educational tours every weekend for families, schools, and sustainable farming enthusiasts. Please book in advance through our contact form."
              }
            ]
          }
        }
      },
